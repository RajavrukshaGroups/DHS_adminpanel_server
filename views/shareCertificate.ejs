<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Share Certificate</title>
    <link rel="stylesheet" href="/css/sharecertificate.css" />
  </head>
  <body>
    <div class="certificate-border">
      <div class="certificate-container">
        <header class="certificate-header">
          <img
            src="https://res.cloudinary.com/dwmeclnky/image/upload/v1747305009/dhs-new-logo_kmxqfk.png"
            alt="DHS Logo"
            class="logo"
          />
          <h2 class="kannada-title">
            ಡಿಫೆನ್ಸ್ ಹ್ಯಾಬಿಟಾಟ್ ಹೌಸಿಂಗ್ ಕೋ-ಆಪರೇಟಿವ್ ಸೊಸೈಟೀ ಲಿಮಿಟೆಡ್.
          </h2>
          <h1 class="main-title">
            DEFENCE HABITAT HOUSING CO-OPERATIVE SOCIETY LIMITED.
          </h1>
          <p class="reg-details">
            <span class="reg-clr">Reg. No:- HSG-3/64/HHS/53744/2020-21</span>
            <br />
            <span class="uni-col">
              #2624, 7th Cross, 14th Main, E-Block, Sahakar Nagar, Bangalore -
              560092, Ph: 080-29903931
            </span>
          </p>
          <h2 class="certificate-title">SHARE CERTIFICATE</h2>
        </header>

        <div class="share-info">
          <div class="left">
            <p>
              <span class="uni-col">No.</span>
              <span class="certificate-number"
                ><%= member.ShareCertificateNumber %></span
              >
            </p>
          </div>
          <div class="right">
            <p>
              <span class="uni-col">No. of Shares:</span>
              <span class="share-count"
                ><%= sharePayment.numberOfShares %></span
              >
            </p>
          </div>
        </div>

        <main class="certificate-body">
          <p>
            <span class="uni-col"
              >This is to certify that <%= member.saluation %>.</span
            >
            <strong
              ><span class="dotted-underline"><%= member.name %>, <%= member.contactAddress %></span></strong
            >
            <span class="uni-col">
              is a member of the Defence Habitat Housing Co-operative Society
              Limited and holds
            </span>
            <strong
              ><span class="dotted-underline"
                ><%= numberOfSharesInWords %></span
              ></strong
            >
            <br></br>
            <span class="uni-col">Fully paid-up shares of rupees</span>
            <strong
              ><span class="dotted-underline"
                ><%= shareValueInWords %></span
              ></strong
            >
          </p>
          <p>
            <span class="uni-col"
              >Subject to the rules of regulations governed by the
              Society.</span
            >
          </p>
          <p>
            <span class="uni-col"
              >This will be handed over to you, on the day of</span
            >
            <strong
              ><span class="dotted-underline">
                <!-- <%= new Date(member.date).toLocaleDateString("en-IN") %> -->
                <!-- <%= dateOfIssue %> -->
                <%= dateOfTransfer?dateOfTransfer:dateOfIssue %>
                </span
              ></strong
            >
          </p>

          <p>
            <span class="uni-col">Name of the Nominee:</span>
            <strong class="nom-relationship">
              <span class="dotted-underline"><%= member.nomineeName %></span>
            </strong>
            &nbsp;&nbsp; <span class="uni-col">Relationship:</span>
            <strong class="nom-relationship">
              <span class="dotted-underline"
                ><%= member.nomineeRelation %></span
              >
            </strong>
          </p>
        </main>

        <footer class="certificate-footer">
          <div class="signature-box">
            <img
              src="https://res.cloudinary.com/dwmeclnky/image/upload/v1747303140/sign-sec_bzvsze.jpg"
              alt="Signature"
              class="signature-img"
            />
            <p><span class="uni-col">Secretary</span></p>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
