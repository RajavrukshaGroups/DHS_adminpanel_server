<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Site Booking Confirmation</title>
  <link rel="stylesheet" href="/css/viewSiteConfirmation.css" />
</head>
<body class="<%= viewOnly ? 'view-only' : '' %>">
  <!-- <% if (viewOnly) { %>
<div class="watermark">
  VIEW ONLY
</div>
<% } %> -->
    <div class="container">
      <% if (viewOnly) { %>
<div class="receipt-watermark">VIEW ONLY</div>
<% } %>
    <div class="logo-section">
      <img src="/images/letterheader.jpg" alt="Header Image" class="header-img" />
    </div>

    <div class="document-header">
      <!-- <div><%= receipt.member.ConfirmationLetterNo %></div> -->
      <div><%= confirmationLetterNumber %></div>
      <div>Date: <%= new Date(confirmationLetterIssueDate).toLocaleDateString('en-GB').split('/').join('-') %></div>
    </div>

    <div class="title">SITE BOOKING CONFIRMATION</div>

    <div class="content">
      <div class="confirmation-text">
        This is to confirm that 
        <span class="bold"><%= member.userId.saluation %> <%= member.userId.name %></span>, 
        is residing at 
        <span class="bold"><%= siteDownPayment.correspondenceAddress %></span>, 
        booked a site of measuring 
        <span class="bold"><%= member.userId.propertyDetails.length %>X<%= member.userId.propertyDetails.breadth %></span> 
        (Rate per SQFT Rs.<%= receipt.member.propertyDetails.pricePerSqft %>/–) on this day of
        <span class="bold"><%= new Date(siteDownPayment?.date).toLocaleDateString('en-GB').split('/').join('-') %></span> in the proposed 
        <% if (member.userId.propertyDetails.projectName.toLowerCase() === "defence habitat - marasandra") { %>
          <span class="bold project-name">"Defence Habitat"</span>
        <% } else { %>
          <span class="bold project-name"><%= `"${member.userId.propertyDetails.projectName}"` %></span>
        <% } %>, 
        located at <span><%= projectLocation %></span>. 
        You have boooked your site by paying an initial amount of 
        <span class="bold">Rs.<%= new Number(totalPaidAmount?totalPaidAmount:siteDownPayment?.amount).toLocaleString('en-IN') %>/–</span> 
</span>

        (Rupees <span class="bold"><%= amountInWordsTotalPaidAmount?amountInWordsTotalPaidAmount:amountInWords %></span>) 
<%
  const payments =
    confirmationPayments?.length > 0
      ? confirmationPayments
      : [siteDownPayment];

  const groupedModes = {};

  payments.forEach((payment) => {
    const mode = payment?.paymentMode?.toLowerCase() || "other";

    if (!groupedModes[mode]) {
      groupedModes[mode] = [];
    }

    groupedModes[mode].push(payment);
  });

  const modeEntries = Object.entries(groupedModes);

  // const allUniqueBanks = [
  //   ...new Set(
  //     payments.map(
  //       (p) => `${p.bankName} Bank, ${p.branchName} Branch`
  //     )
  //   ),
  // ];
  const uniqueBankNames = [
  ...new Set(payments.map((p) => p.bankName)),
];

const uniqueBranchNames = [
  ...new Set(payments.map((p) => p.branchName)),
];
%>

<% modeEntries.forEach(([mode, modePayments], modeIndex) => { %>

  <% if (modeIndex > 0) { %>
    and
  <% } %>

  <% if (mode === 'cheque') { %>

    <!-- by way of cheque bearing No.

    <% modePayments.forEach((payment, index) => { %>

      <% if (index > 0) { %>
        /
      <% } %>

      <span class="bold"><%= payment.chequeNumber %></span>

    <% }) %> -->
    by way of cheque bearing No.<% modePayments.forEach((payment, index) => { %><% if (index > 0) { %>/<% } %><span class="bold"><%= payment.chequeNumber %></span><% }) %>

  <% } else if (mode === 'netbanking/upi') { %>

    <!-- by mode of NEFT/RTGS Ref No.

    <% modePayments.forEach((payment, index) => { %>

      <% if (index > 0) { %>
        /
      <% } %>

      <span class="bold"><%= payment.transactionId %></span>

    <% }) %> -->
    by mode of NEFT/RTGS Ref No.<% modePayments.forEach((payment, index) => { %><% if (index > 0) { %>/<% } %><span class="bold"><%= payment.transactionId %></span><% }) %>

  <% } else if (mode === 'dd') { %>

    <!-- via DD No.

    <% modePayments.forEach((payment, index) => { %>

      <% if (index > 0) { %>
        /
      <% } %>

      <span class="bold"><%= payment.ddNumber %></span>

    <% }) %> -->
    via DD No.<% modePayments.forEach((payment, index) => { %><% if (index > 0) { %>/<% } %><span class="bold"><%= payment.ddNumber %></span><% }) %>

  <% } else { %>

    by <span class="bold"><%= mode %></span>

  <% } %>

<% }) %>

drawn at

<% uniqueBankNames.forEach((bank, index) => { %>

  <% if (index > 0 && index === uniqueBankNames.length - 1) { %>
    and
  <% } else if (index > 0) { %>
    ,
  <% } %>

  <span class="bold"><%= bank %></span>

<% }) %>

Bank,

<% uniqueBranchNames.forEach((branch, index) => { %>

  <% if (index > 0 && index === uniqueBranchNames.length - 1) { %>
    and
  <% } else if (index > 0) { %>
    ,
  <% } %>

  <span class="bold"><%= branch %></span>

<% }) %> Branch.
        The booked site dimension is <span class="bold"><%= member.userId.propertyDetails.length * member.userId.propertyDetails.breadth %></span> SQFT. 

<%
  const receiptNumbers = Array.isArray(confirmationLetterReceiptNo)
    ? confirmationLetterReceiptNo
    : confirmationLetterReceiptNo
      ? [confirmationLetterReceiptNo]
      : [siteDownPayment?.receiptNo];

  const receiptLabel =
    receiptNumbers.length > 1
      ? "Receipt numbers are"
      : "Receipt number is";
%>

<%= receiptLabel %>
<span class="bold"><%= receiptNumbers.join(", ") %></span>, 

Membership No:<span class="bold"><%= member.userId.MembershipNo %></span>, 
Seniority Number <span class="bold"><%= member.userId.SeniorityID %></span>.
      </div>

      <div class="conditions">
        <div class="conditions-title">The site is booked under the following conditions:</div>
        <span>The booking of your site is purely based on rules and regulations of the society and provisions of Karnataka 
co-operative registration act and the rules and By-laws of the society.</span>
        <ol>
          <li>The allotment of site is subject to approval of membership/associate membership, clearance of land 
by concerned authority and subject to availability of the site.</li>
          <li>Sites will be allotted on a first come first serve basis and Conditions mentioned behind the 
application will be applicable. Seniority number may change, in case of failing to pay the installment 
amount in time.</li>
          <li>Withdrawals or transfers of membership/bookings are only after the completion of the project 
period. Any withdrawal before completion of the project will be liable for penalty and Interest will 
not be paid for any withdrawals of site advances.</li>
<li>All the remaining payments should be paid as per Defence Habitat Housing Co-operative Society 
Norms. Bank loans will be arranged from leading banks after the plan approval.</li>
          <li>Installment amount should be paid within <%= duration %> from the date of booking confirmation.</li>
          <li>Corner/Commercial plots will be charged extra.</li>
          <li>Any issues that arise in the process of completion of the project should be resolved in the General 
Body Meeting.</li>
          <li>As per rules & regulations of Karnataka Co-Operative Department, the paid amount will be 
refundable in case of project failure.</li>
        </ol>
      </div>
    </div>

    <div class="footer-image">
      <img src="/images/footerSign.jpg" alt="Footer Signature" class="footer-img"/>
    </div>
  </div>
  <% if (viewOnly) { %>
<script>
  // Disable right click
  document.addEventListener(
    "contextmenu",
    (e) => e.preventDefault(),
  );

  // Disable Ctrl+P / Ctrl+S
  document.addEventListener(
    "keydown",
    (e) => {
      if (
        (e.ctrlKey || e.metaKey) &&
        (
          e.key.toLowerCase() === "p" ||
          e.key.toLowerCase() === "s"
        )
      ) {
        e.preventDefault();

        alert(
          "Download and print are disabled",
        );
      }
    },
  );

  // Block browser print
  window.onbeforeprint = function () {
    alert("Printing is disabled");
    return false;
  };
</script>
<% } %>
</body>
</html>
