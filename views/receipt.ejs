<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Receipt</title>
    <link rel="stylesheet" href="/css/receipt.css" />
  </head>
  <!-- <body> -->
    <body class="<%= viewOnly ? 'view-only' : '' %>"></body>
    <% if (viewOnly) { %>
<div class="watermark">VIEW ONLY</div>
<% } %>
    <div class="receipt-box">
      <header>
        <img
          src="https://res.cloudinary.com/dwmeclnky/image/upload/v1747305009/dhs-new-logo_kmxqfk.png"
          alt="DHS Logo"
          class="logo"
        />
        <div class="header-text">
          <h1>DEFENCE HABITAT HOUSING CO-OPERATIVE SOCIETY LTD.</h1>
          <p>
            Behind Swathi Gardenia Hotel, Sahakar Nagar E Block, Bangalore -
            560092
          </p>
          <p>Mobile: +91 7026147770</p>
        </div>
      </header>

      <section class="receipt-header">
        <div>
          No. <strong class="highlight-red"><%= receiptNumber %></strong>
        </div>
        <div class="receipt">RECEIPT</div>
        <div>Date: <strong><%= date %></strong></div>
      </section>

      <section class="details-grid">
        <div class="line">
          <!-- Received from Smt. / Sri <span><%= name %></span> -->
          Received from <%= salutation %>.<span><%= name %></span>
        </div>
        <div class="line">Address <span><%= address %></span></div>
        <div class="line">Rupees <span><%= amountInWords %></span></div>
        <!-- <div class="line">by <span><%= paymentMode %></span></div> -->

        <% if (paymentMode?.toLowerCase() !== "cash") { %>
        <div class="line">
          RTGS / CHEQUES / DD No
          <span>
            <% if (paymentMode?.toLowerCase() === "netbanking" || paymentMode?.toLowerCase()==="netbanking/upi") { %> <%=
            transactionId %> <% } else if (paymentMode?.toLowerCase() ===
            "cheque") { %> <%= chequeNumber %> <% } else if
            (paymentMode?.toLowerCase() === "dd") { %> <%= ddNumber %> <% } else
            { %> - <% } %>
          </span>
        </div>
        <div class="line">
          Branch <span><%= branchName || "-" %></span> &nbsp;&nbsp;&nbsp; Bank
          <span><%= bankName || "-" %></span>
        </div>
        <% } %> <% if (projectName) { %>
        <div class="line">Project Name <span><%= projectName %></span></div>
        <% } %>
      </section>

      <table class="fee-table fixed">
        <thead>
          <tr>
            <th></th>
            <th></th>
            <th></th>
            <th>L.F.</th>
            <th>Rs.</th>
            <th>Ps.</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((item, idx) => { %>
          <tr>
            <td><%= idx + 1 %>.</td>
            <td><%= item.name %></td>
            <td class="dotted-cell">
              <span
                ><%= (item.name && item.amount > 0) ? plotDimension : ''
                %></span>
            </td>

            <td></td>
            <td>
              <%= (item.amount && item.amount>0)?item.formattedAmount:"" %>
            </td>
            <td><%= (item.amount && item.amount > 0) ? "00" : "" %></td>
          </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <td></td>
            <td colspan="3">Total</td>
            <td><%= total %></td>
            <td>00</td>
          </tr>
        </tfoot>
      </table>

      <div class="signature">
        <img
          src="https://res.cloudinary.com/dwmeclnky/image/upload/v1747303140/sign-sec_bzvsze.jpg"
          alt="Signature"
        />
        <div class="footer-role">President / Secretary</div>
      </div>
    </div>
    <% if (viewOnly) { %>
<script>
  // Disable right click
  document.addEventListener("contextmenu", (e) =>
    e.preventDefault(),
  );

  // Disable Ctrl+P / Cmd+P
  document.addEventListener("keydown", (e) => {
    if (
      (e.ctrlKey || e.metaKey) &&
      e.key.toLowerCase() === "p"
    ) {
      e.preventDefault();
      alert("Printing is disabled");
    }

    // Optional:
    // Disable Ctrl+S
    if (
      (e.ctrlKey || e.metaKey) &&
      e.key.toLowerCase() === "s"
    ) {
      e.preventDefault();
      alert("Downloading is disabled");
    }
  });

  // Block print event
  window.onbeforeprint = function () {
    alert("Printing is disabled");
    return false;
  };
</script>
<% } %>
  </body>
</html>
